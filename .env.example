# ============================================================
# Hopia Fits - environment configuration EXAMPLE
# ============================================================
#
# Copy this file to ".env" and fill in the real values. The real
# ".env" is git-ignored and must never be committed. These keys are
# read by includes/database.php (DB_*) and includes/gcash.php (GCASH_*)
# through vlucas/phpdotenv, which populates $_ENV at request start.
#
# Do NOT commit real credentials or a real receiving account here.
# ------------------------------------------------------------

# --- Database (required) ---
DB_HOST=127.0.0.1
DB_NAME=clothing_shop
DB_USER=your_db_user
DB_PASS=your_db_password

# --- Google customer authentication (optional) ---
# Create a Google OAuth 2.0 Web application client. The redirect URI must
# exactly match the authorized URI configured in Google Cloud Console.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://your-domain.example/customer/google-callback.php

# --- Password reset email (required for Forgot Password) ---
# APP_BASE_URL must be the trusted public root URL with no path, query, or fragment.
# Use http://localhost:8000 locally and https://hopiafits.shop in production.
APP_BASE_URL=https://your-domain.example
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_LOGIN=your_brevo_smtp_login
BREVO_SMTP_KEY=your_brevo_smtp_key
# Use a sender identity that is verified and authorized in Brevo.
BREVO_SENDER_NAME=Hopia Fits
BREVO_SENDER_EMAIL=verified-sender@example.com

# --- Manual GCash payment (Phase 2) ---
#
# These describe the shop's REAL GCash receiving account. The shop
# supplies them separately. Until BOTH the name and number are set to
# real values, the GCash option is withheld at checkout and no
# receiving account is ever displayed, so a customer can never be
# shown a placeholder/misleading destination.
#
# GCASH_ACCOUNT_NAME   Registered GCash account holder name (as it
#                      appears in the GCash app).
# GCASH_ACCOUNT_NUMBER The GCash mobile number that receives payments
#                      (e.g. 09XXXXXXXXX).
# GCASH_QR_IMAGE       OPTIONAL. Project-relative path to a GCash QR
#                      image placed under images/ (e.g.
#                      images/gcash/qr.png). Leave blank to show no QR.
GCASH_ACCOUNT_NAME=
GCASH_ACCOUNT_NUMBER=
GCASH_QR_IMAGE=
